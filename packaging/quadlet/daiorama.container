[Unit]
Description=dAIorama manager (quadlet, default instance)
Wants=network-online.target
After=network-online.target

[Container]
Image=localhost/daiorama:dev
ContainerName=daiorama
# Same command as the bare-host unit, run by the image instead of the host binary (09).
Exec=daiorama serve
Environment=XDG_DATA_HOME=/data
Environment=XDG_CONFIG_HOME=/config
Environment=XDG_RUNTIME_DIR=/run
Volume=%h/.local/share/daiorama-container/data:/data:Z
Volume=%h/.local/share/daiorama-container/config:/config:Z
# Per-session limits need a writable, delegated cgroupfs (06). Hosts that cannot
# delegate: drop both lines and set limits.mode off.
Volume=/sys/fs/cgroup:/sys/fs/cgroup:rw
# Quadlet has no cgroup-namespace key; the spike's host-namespace flag goes through here.
PodmanArgs=--cgroupns=host
AddDevice=/dev/dri/renderD128
GroupAdd=keep-groups
DropCapability=all
NoNewPrivileges=true
PublishPort=127.0.0.1:8756:8756
PublishPort=127.0.0.1:6080-6099:6080-6099

[Service]
Restart=on-failure
RestartSec=2
TimeoutStopSec=30

[Install]
WantedBy=default.target
