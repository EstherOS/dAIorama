# dAIorama core image — substrate only, no default command (09, "Image split").
#
# The base digest is a required build argument, never a checked-in default: a default
# goes stale silently, and the release manifest records what a build actually used
# (09, C2). The runbook shows how to read the digest for the tag.
ARG DEBIAN_SID_DIGEST
FROM docker.io/library/debian:sid-slim@${DEBIAN_SID_DIGEST} AS build

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
    && apt-get install -y --no-install-recommends rustc cargo ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
# The workspace manifest names both members; the binary needs neither tests nor docs.
COPY Cargo.toml Cargo.lock ./
COPY src ./src
COPY dashboard ./dashboard
RUN cargo build --release --locked -p daiorama

FROM docker.io/library/debian:sid-slim@${DEBIAN_SID_DIGEST}

ENV DEBIAN_FRONTEND=noninteractive
# What the binary actually runs (09): the compositor stack and its parent, capture and
# view tools, Mesa userspace, Xwayland and D-Bus. No browser, no terminal, and no
# wtype/wlrctl — those are the L1 harness's stand-ins, not the product's input path.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        hyprland mutter wayvnc grim wf-recorder \
        libgl1-mesa-dri libegl1 libgles2 libgbm1 wayland-utils \
        xwayland dbus seatd fontconfig fonts-dejavu-core ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build /src/target/release/daiorama /usr/local/bin/daiorama

# One path set for the manager, the CLI and the compose mounts (08, 09).
ENV XDG_DATA_HOME=/data \
    XDG_CONFIG_HOME=/config \
    XDG_RUNTIME_DIR=/run

# No CMD and no ENTRYPOINT: the core image is a substrate and the operator's command is
# the contract (09). The desktop image is the one artifact with a default command.
