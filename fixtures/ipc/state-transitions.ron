// state-transitions — `running → degraded → dead` as seen from the CLI (06 B3).
//
// Degraded is transient and never a resting state; dead keeps the entry listable and
// inspectable until something closes it. The session object's `state` field is the only thing
// that changes between the three reads.
(
  name: "state-transitions",
  description: "Session detail renders running, degraded and dead in turn; each read is the pinned session object.",
  steps: [
    (
      expect: (method: "handshake", params: (protocol_version: "0.1.0", min_supported: "0.1.0")),
      respond: (result: (protocol_version: "0.1.0", min_supported: "0.1.0", instance_id: "11111111-1111-4111-8111-111111111111")),
    ),
    (
      expect: (method: "session_status", params: (session_id: "s-3")),
      respond: (result: (
        id: "s-3", label: "", state: "running", backend: "headless",
        resolution: "1920x1080", scale: 1.0, scope: "operator", origin: "shell",
        idle_since: "2026-10-15T17:00:00Z", view: (),
        instance_id: "11111111-1111-4111-8111-111111111111", renderer: "verified",
      )),
    ),
    (
      expect: (method: "handshake", params: (protocol_version: "0.1.0", min_supported: "0.1.0")),
      respond: (result: (protocol_version: "0.1.0", min_supported: "0.1.0", instance_id: "11111111-1111-4111-8111-111111111111")),
    ),
    (
      expect: (method: "session_status", params: (session_id: "s-3")),
      respond: (result: (
        id: "s-3", label: "", state: "degraded", backend: "headless",
        resolution: "1920x1080", scale: 1.0, scope: "operator", origin: "shell",
        idle_since: "2026-10-15T17:00:00Z", view: (),
        instance_id: "11111111-1111-4111-8111-111111111111", renderer: "verified",
      )),
    ),
    (
      expect: (method: "handshake", params: (protocol_version: "0.1.0", min_supported: "0.1.0")),
      respond: (result: (protocol_version: "0.1.0", min_supported: "0.1.0", instance_id: "11111111-1111-4111-8111-111111111111")),
    ),
    (
      expect: (method: "session_status", params: (session_id: "s-3")),
      respond: (result: (
        id: "s-3", label: "", state: "dead", backend: "headless",
        resolution: "1920x1080", scale: 1.0, scope: "operator", origin: "shell",
        idle_since: "2026-10-15T17:00:00Z", view: (),
        instance_id: "11111111-1111-4111-8111-111111111111", renderer: "verified",
      )),
    ),
  ],
  runs: [
    (
      argv: ["status", "s-3", "--json"],
      expect_exit: 0,
      expect_stdout_json: (
        id: "s-3", label: "", state: "running", backend: "headless",
        resolution: "1920x1080", scale: 1.0, scope: "operator", origin: "shell",
        idle_since: "2026-10-15T17:00:00Z", view: (),
        instance_id: "11111111-1111-4111-8111-111111111111", renderer: "verified",
      ),
    ),
    (
      argv: ["status", "s-3"],
      expect_exit: 0,
      expect_stdout_contains: ["state: degraded"],
    ),
    (
      argv: ["status", "s-3"],
      expect_exit: 0,
      expect_stdout_contains: ["state: dead"],
      expect_stdout_not_contains: ["restart"],
    ),
  ],
)
