// new-quota-exceeded — `quota_exceeded` carries scope + global numbers in the message (05).
//
// Message = the 04 string verbatim, with `{scope} {n}/{max}` and `{g}/{gmax}` filled in.
// 06: dead sessions hold no live resources and are not part of these numbers.
(
  name: "new-quota-exceeded",
  description: "A create past the scope and global ceilings fails with `quota_exceeded` carrying both numbers, exit 1.",
  steps: [
    (
      expect: (method: "handshake", params: (protocol_version: "0.1.0", min_supported: "0.1.0")),
      respond: (result: (protocol_version: "0.1.0", min_supported: "0.1.0", instance_id: "11111111-1111-4111-8111-111111111111")),
    ),
    (
      expect: (method: "create_session", params: (backend: "headless")),
      respond: (error: (
        code: "quota_exceeded",
        message: "session limit reached: scope 'operator' 3/4; global 7/8. Close a session first.",
        hint: "close a session or raise the scope quota",
      )),
    ),
  ],
  runs: [
    (
      argv: ["new"],
      expect_exit: 1,
      expect_stderr_contains: [
        "session limit reached: scope 'operator' 3/4; global 7/8. Close a session first. (quota_exceeded)",
        "hint: close a session or raise the scope quota",
      ],
    ),
  ],
)
