// view-down-session-running — a view process dying is *not* a session dying (06 §Views).
//
// The session stays `running` while its view reads `down`; the stale front address keeps its
// old generation, so a cached address is detectable instead of silently dead, and the next
// `get_view` starts a fresh view with the next generation.
(
  name: "view-down-session-running",
  description: "Session detail shows a down view while the session keeps running; the next view start returns the new generation.",
  steps: [
    (
      expect: (method: "handshake", params: (protocol_version: "0.1.0", min_supported: "0.1.0")),
      respond: (result: (protocol_version: "0.1.0", min_supported: "0.1.0", instance_id: "11111111-1111-4111-8111-111111111111")),
    ),
    (
      expect: (method: "session_status", params: (session_id: "s-7")),
      respond: (result: (
        id: "s-7", label: "", state: "running", backend: "headless",
        resolution: "1920x1080", scale: 1.0, scope: "operator", origin: "shell",
        idle_since: "2026-10-15T17:00:00Z",
        view: (
          state: "down",
          address: "http://127.0.0.1:6080/?credential=11aa",
          front_port: 6080,
          vnc_port: 5901,
          generation: 1,
        ),
        instance_id: "11111111-1111-4111-8111-111111111111", renderer: "verified",
      )),
    ),
    (
      expect: (method: "handshake", params: (protocol_version: "0.1.0", min_supported: "0.1.0")),
      respond: (result: (protocol_version: "0.1.0", min_supported: "0.1.0", instance_id: "11111111-1111-4111-8111-111111111111")),
    ),
    (
      expect: (method: "get_view", params: (session_id: "s-7")),
      respond: (result: (
        state: "starting",
        address: "http://127.0.0.1:6080/?credential=22bb",
        front_port: 6080,
        vnc_port: 5902,
        generation: 2,
      )),
    ),
  ],
  runs: [
    (
      argv: ["status", "s-7", "--json"],
      expect_exit: 0,
      expect_stdout_json: (
        id: "s-7", label: "", state: "running", backend: "headless",
        resolution: "1920x1080", scale: 1.0, scope: "operator", origin: "shell",
        idle_since: "2026-10-15T17:00:00Z",
        view: (
          state: "down",
          address: "http://127.0.0.1:6080/?credential=11aa",
          front_port: 6080,
          vnc_port: 5901,
          generation: 1,
        ),
        instance_id: "11111111-1111-4111-8111-111111111111", renderer: "verified",
      ),
    ),
    (
      argv: ["view", "s-7"],
      expect_exit: 0,
      expect_stdout_contains: ["http://127.0.0.1:6080/?credential=22bb"],
    ),
  ],
)
