// close-unknown — an id that never existed is `session_not_found` with the corrective hint.
//
// The reference shape, spelled out: the same CLI path as close-closed, a
// different code and hint, because "never existed" and "closed" are different answers.
(
  name: "close-unknown",
  description: "Closing an id that never existed answers `session_not_found` with the list-sessions hint, exit 1.",
  steps: [
    (
      expect: (method: "handshake", params: (protocol_version: "0.1.0", min_supported: "0.1.0")),
      respond: (result: (protocol_version: "0.1.0", min_supported: "0.1.0", instance_id: "11111111-1111-4111-8111-111111111111")),
    ),
    (
      expect: (method: "close_session", params: (session_id: "missing")),
      respond: (error: (
        code: "session_not_found",
        message: "session not found",
        hint: "list sessions to find one",
      )),
    ),
  ],
  runs: [
    (
      argv: ["close", "missing"],
      expect_exit: 1,
      expect_stderr_contains: [
        "session not found (session_not_found)",
        "hint: list sessions to find one",
      ],
    ),
  ],
)
