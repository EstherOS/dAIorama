// session-reaped — a reaped session is not a closed one (06: reaped ≠ closed ≠ dead).
//
// A reap marks the entry dead with cause `reaped`; while the entry lives, calls answer
// `session_reaped`. The sweep closes it later, and the reaped tombstone keeps the distinct
// code visible inside the 24 h window.
(
  name: "session-reaped",
  description: "A call on a reaped session answers `session_reaped` (distinct from closed and not-found), exit 1.",
  steps: [
    (
      expect: (method: "handshake", params: (protocol_version: "0.1.0", min_supported: "0.1.0")),
      respond: (result: (protocol_version: "0.1.0", min_supported: "0.1.0", instance_id: "11111111-1111-4111-8111-111111111111")),
    ),
    (
      expect: (method: "close_session", params: (session_id: "s-2")),
      respond: (error: (
        code: "session_reaped",
        message: "session was reaped",
        hint: "create a new session",
      )),
    ),
  ],
  runs: [
    (
      argv: ["close", "s-2"],
      expect_exit: 1,
      expect_stderr_contains: [
        "session was reaped (session_reaped)",
        "hint: create a new session",
      ],
      expect_stderr_not_contains: ["session_not_found", "session_closed"],
    ),
  ],
)
