// list-paged — a truncated page prints `next_cursor` (04); --json prints the page shape
// unmodified (05 "List page: {sessions: [...], next_cursor}").
//
// The scope, origin and idle-since fields are part of the list contract (04: "sessions with
// status, scope, origin, idle-since").
(
  name: "list-paged",
  description: "A truncated page prints `next_cursor`; the JSON form is the page shape with the full session objects.",
  steps: [
    (
      expect: (method: "handshake", params: (protocol_version: "0.1.0", min_supported: "0.1.0")),
      respond: (result: (protocol_version: "0.1.0", min_supported: "0.1.0", instance_id: "11111111-1111-4111-8111-111111111111")),
    ),
    (
      expect: (method: "list_sessions", params: (limit: 2)),
      respond: (result: (
        sessions: [
          (
            id: "s-1",
            label: "first",
            state: "running",
            backend: "headless",
            resolution: "1920x1080",
            scale: 1.0,
            scope: "operator",
            origin: "shell",
            idle_since: "2026-10-15T17:00:00Z",
            view: (),
            instance_id: "11111111-1111-4111-8111-111111111111",
            renderer: "verified",
          ),
          (
            id: "s-2",
            label: "",
            state: "dead",
            backend: "nested",
            resolution: "1280x720",
            scale: 1.5,
            scope: "operator",
            origin: "mcp",
            idle_since: "2026-10-15T17:05:00Z",
            view: (),
            instance_id: "11111111-1111-4111-8111-111111111111",
            renderer: "software",
          ),
        ],
        next_cursor: "c2",
      )),
    ),
    (
      expect: (method: "handshake", params: (protocol_version: "0.1.0", min_supported: "0.1.0")),
      respond: (result: (protocol_version: "0.1.0", min_supported: "0.1.0", instance_id: "11111111-1111-4111-8111-111111111111")),
    ),
    (
      expect: (method: "list_sessions", params: (limit: 2)),
      respond: (result: (
        sessions: [
          (
            id: "s-1",
            label: "first",
            state: "running",
            backend: "headless",
            resolution: "1920x1080",
            scale: 1.0,
            scope: "operator",
            origin: "shell",
            idle_since: "2026-10-15T17:00:00Z",
            view: (),
            instance_id: "11111111-1111-4111-8111-111111111111",
            renderer: "verified",
          ),
          (
            id: "s-2",
            label: "",
            state: "dead",
            backend: "nested",
            resolution: "1280x720",
            scale: 1.5,
            scope: "operator",
            origin: "mcp",
            idle_since: "2026-10-15T17:05:00Z",
            view: (),
            instance_id: "11111111-1111-4111-8111-111111111111",
            renderer: "software",
          ),
        ],
        next_cursor: "c2",
      )),
    ),
  ],
  runs: [
    (
      argv: ["list", "--limit", "2"],
      expect_exit: 0,
      expect_stdout_contains: [
        "next_cursor: c2",
        "ID  STATE  BACKEND  SCOPE  ORIGIN  IDLE-SINCE",
        "s-1  running  headless  operator  shell  2026-10-15T17:00:00Z",
      ],
    ),
    (
      argv: ["list", "--limit", "2", "--json"],
      expect_exit: 0,
      expect_stdout_json: (
        sessions: [
          (
            id: "s-1",
            label: "first",
            state: "running",
            backend: "headless",
            resolution: "1920x1080",
            scale: 1.0,
            scope: "operator",
            origin: "shell",
            idle_since: "2026-10-15T17:00:00Z",
            view: (),
            instance_id: "11111111-1111-4111-8111-111111111111",
            renderer: "verified",
          ),
          (
            id: "s-2",
            label: "",
            state: "dead",
            backend: "nested",
            resolution: "1280x720",
            scale: 1.5,
            scope: "operator",
            origin: "mcp",
            idle_since: "2026-10-15T17:05:00Z",
            view: (),
            instance_id: "11111111-1111-4111-8111-111111111111",
            renderer: "software",
          ),
        ],
        next_cursor: "c2",
      ),
    ),
  ],
)
