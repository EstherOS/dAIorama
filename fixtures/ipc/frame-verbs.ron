// frame-verbs — the remaining "implement against the frame" verbs: `drain`
// (including `--wait`), `config reload`, and `view --stop`.
//
// All three are cold-class commands that RPC a running manager: they never start one, and with
// no manager they answer `no manager running` (covered by cold-no-manager). Here they talk to
// the fake manager over the frame.
(
  name: "frame-verbs",
  description: "`drain` (and `--wait`), `config reload` and `view --stop` speak the frame and render their answers.",
  steps: [
    (
      expect: (method: "handshake", params: (protocol_version: "0.1.0", min_supported: "0.1.0")),
      respond: (result: (protocol_version: "0.1.0", min_supported: "0.1.0", instance_id: "11111111-1111-4111-8111-111111111111")),
    ),
    (
      expect: (method: "drain"),
      respond: (result: (active: true, remaining: 2)),
    ),
    (
      expect: (method: "handshake", params: (protocol_version: "0.1.0", min_supported: "0.1.0")),
      respond: (result: (protocol_version: "0.1.0", min_supported: "0.1.0", instance_id: "11111111-1111-4111-8111-111111111111")),
    ),
    (
      // `--wait` polls over the same connection.
      expect: (method: "drain"),
      respond: (result: (active: true, remaining: 2)),
    ),
    (
      expect: (method: "drain"),
      respond: (result: (active: true, remaining: 0)),
    ),
    (
      // A new run is a new connection: another handshake.
      expect: (method: "handshake", params: (protocol_version: "0.1.0", min_supported: "0.1.0")),
      respond: (result: (protocol_version: "0.1.0", min_supported: "0.1.0", instance_id: "11111111-1111-4111-8111-111111111111")),
    ),
    (
      expect: (method: "config_reload"),
      respond: (result: (reloaded: true, restart_only: ["manager.bind", "token"])),
    ),
    (
      expect: (method: "handshake", params: (protocol_version: "0.1.0", min_supported: "0.1.0")),
      respond: (result: (protocol_version: "0.1.0", min_supported: "0.1.0", instance_id: "11111111-1111-4111-8111-111111111111")),
    ),
    (
      expect: (method: "stop_view", params: (session_id: "s-1")),
      respond: (result: (stopped: true)),
    ),
  ],
  runs: [
    (
      argv: ["drain"],
      expect_exit: 0,
      expect_stdout_contains: ["draining; 2 still running"],
    ),
    (
      argv: ["drain", "--wait", "--timeout", "5"],
      expect_exit: 0,
      expect_stdout_contains: ["drain complete"],
    ),
    (
      argv: ["config", "reload"],
      expect_exit: 0,
      expect_stdout_contains: [
        "config reloaded",
        "restart-only (takes effect at next manager start): manager.bind, token",
      ],
    ),
    (
      argv: ["view", "s-1", "--stop"],
      expect_exit: 0,
      expect_stdout_contains: ["view stopped"],
    ),
  ],
)
